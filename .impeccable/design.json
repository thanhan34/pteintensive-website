      "css": ".ds-input{display:flex;height:40px;width:100%;border-radius:6px;border:1px solid hsl(var(--input,214.3 31.8% 91.4%));background:hsl(var(--background,0 0% 100%));color:#171717;padding:8px 12px;font-family:var(--font-body,Manrope),sans-serif;font-size:14px}.ds-input::placeholder{color:hsl(var(--muted-foreground,215.4 16.3% 46.9%))}.ds-input:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background,0 0% 100%)),0 0 0 4px hsl(var(--ring,22 100% 50%))}.ds-input:disabled{cursor:not-allowed;opacity:.5}"
