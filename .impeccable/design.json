    {
      "name": "Shared Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compact shared Button default variant.",
      "html": "<button type=\"button\" class=\"ds-primary\">Đăng ký tư vấn</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:8px 16px;border:0;border-radius:6px;background:#fc5d01;color:#fff;font-family:var(--font-body,Manrope),sans-serif;font-size:14px;font-weight:500;white-space:nowrap;transition:color .15s,background-color .15s}.ds-primary:hover{background:rgba(252,93,1,.9)}.ds-primary:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background,0 0% 100%)),0 0 0 4px hsl(var(--ring,22 100% 50%))}.ds-primary:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Shared Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Theme-aware bordered shared Button variant.",
      "html": "<button type=\"button\" class=\"ds-outline\">Xem khóa học</button>",
      "css": ".ds-outline{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:8px 16px;border:1px solid hsl(var(--input,214.3 31.8% 91.4%));border-radius:6px;background:hsl(var(--background,0 0% 100%));color:#171717;font-family:var(--font-body,Manrope),sans-serif;font-size:14px;font-weight:500;transition:color .15s,background-color .15s}.ds-outline:hover{background:hsl(var(--accent,210 40% 96%));color:hsl(var(--accent-foreground,222.2 84% 4.9%))}.ds-outline:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background,0 0% 100%)),0 0 0 4px hsl(var(--ring,22 100% 50%))}.ds-outline:disabled{pointer-events:none;opacity:.5}"
    },
    {
