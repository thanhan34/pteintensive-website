      "html": "<a class=\"ds-hero-cta\" href=\"/register\">Nhận lộ trình miễn phí</a>",
      "css": ".ds-hero-cta{display:inline-flex;min-height:56px;align-items:center;justify-content:center;padding:0 28px;border-radius:9999px;background:linear-gradient(to right,#ff4d00,#ff7417);color:#fff;text-decoration:none;font-family:var(--font-body,Manrope),sans-serif;font-size:14px;font-weight:800;letter-spacing:.025em;text-transform:uppercase;box-shadow:0 12px 34px rgba(252,93,1,.35);transition:transform .15s,box-shadow .15s}.ds-hero-cta:hover{transform:translateY(-2px);box-shadow:0 16px 42px rgba(252,93,1,.5)}.ds-hero-cta:focus-visible{outline:none;box-shadow:0 0 0 2px #000,0 0 0 4px #ff8b51}"
    },
    {
      "name": "Shared Input",
      "kind": "input",
