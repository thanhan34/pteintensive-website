# Copy these entries into your server environment. No real credentials belong here.
VNPAY_ENABLED=false
VNPAY_ENVIRONMENT=sandbox
VNPAY_PRODUCTION_APPROVED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
BILLING_BASE_URL=https://your-domain.example
# Enable only if the hosting proxy overwrites the forwarded address.
BILLING_TRUST_PROXY=false
# Billing admin authorization reuses ADMIN_EMAILS from the existing server config.