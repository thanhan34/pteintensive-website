# Copy these entries into your server environment. No real credentials belong here.
VNPAY_ENABLED=false
VNPAY_ENVIRONMENT=sandbox
VNPAY_PRODUCTION_APPROVED=false
VNPAY_TMN_CODE=PTETEST1
VNPAY_HASH_SECRET=
# Sandbox browser return: use http://localhost:3000 when testing on this machine.
# Full IPN testing requires a public HTTPS tunnel pointing to the same local server.
# Production requires a public HTTPS origin (localhost/loopback is rejected).
BILLING_BASE_URL=https://www.pteintensive.com
# Enable only if the hosting proxy overwrites the forwarded address.
BILLING_TRUST_PROXY=false
# Billing admin authorization reuses ADMIN_EMAILS from the existing server config.
# Student login uses a separate Clerk application; obtain keys through Clerk, never commit secrets.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional QueryDR server-to-server lookup. Set the actual server egress IP.
VNPAY_QUERY_IP=
# Production only: confirm the HTTPS endpoint on pay.vnpay.vn with VNPAY.
# Sandbox uses its documented fixed endpoint automatically.
VNPAY_QUERY_URL=